# Copy to .env.local (local) or set in Vercel -> Project -> Settings -> Environment Variables. NEVER commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public https address of the site (used for payment redirects and the Moyasar webhook), e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# Shared secret you also paste into Moyasar dashboard -> Webhooks (any long random string)
MOYASAR_WEBHOOK_SECRET=
